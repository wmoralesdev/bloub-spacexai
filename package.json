{
  "name": "bloub",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "SVG recreation of the x.ai bot avatar. One shape morphing through 14 states, measured off the reference video frame by frame.",
  "license": "MIT",
  "author": "Jérémy Perret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-prt/bloub.git"
  },
  "keywords": [
    "svg",
    "animation",
    "avatar",
    "vue",
    "morphing"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hyperframes/core": "0.8.46",
    "@hyperframes/player": "0.8.46",
    "@hyperframes/producer": "0.8.46",
    "clipper2-ts": "2.0.1-18",
    "gsap": "3.15.0",
    "mediabunny": "^1.54.0",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "25.11.0",
    "qrcode-generator": "2.0.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=24"
  }
}
